# Copy to .env to read your own Google Drive instead of the bundled sample library.
#
# A "Web application" OAuth client from https://console.cloud.google.com/apis/credentials,
# with this app's address (e.g. http://localhost:5173 and your published .graspable.cloud URL)
# as an authorised JavaScript origin, and the Google Drive API enabled for its project.
# The app only ever asks for the read-only scope (drive.readonly) and keeps the token in the
# browser that signed in — see lib/drive.js.
VITE_GOOGLE_CLIENT_ID=

# VITE_GRASPABLE_REALTIME=off   # run single-user, without the multi-user relay
